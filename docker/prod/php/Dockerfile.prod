FROM node:24-bookworm-slim AS node-tools
RUN corepack enable && corepack prepare pnpm@9.12.2 --activate

FROM php:8.4-apache-bookworm AS php-base
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
RUN apt-get update && apt-get install -y --no-install-recommends \
    git unzip libzip-dev libicu-dev libpng-dev libjpeg62-turbo-dev libfreetype6-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j2 pdo_mysql gd zip intl bcmath opcache exif pcntl \
    && pecl install redis-6.2.0 && docker-php-ext-enable redis \
    && rm -rf /var/lib/apt/lists/* \
    && a2enmod rewrite headers remoteip \
    && mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"
WORKDIR /var/www/html
COPY . .
RUN mkdir -p bootstrap/cache storage/app/public storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs \
    && sha256sum composer.lock > /tmp/starter-composer-lock.sha256 \
    && composer install --no-dev --prefer-dist --no-interaction --no-scripts --no-plugins \
    && composer dump-autoload --no-dev --no-interaction --no-scripts --optimize \
    && sha256sum --check /tmp/starter-composer-lock.sha256 \
    && php artisan package:discover --no-interaction \
    && ln -s /var/www/html/storage/app/public public/storage \
    && chown -R www-data:www-data storage bootstrap/cache
COPY docker/prod/php/apache.conf /etc/apache2/sites-available/000-default.conf
COPY docker/prod/php/production.ini /usr/local/etc/php/conf.d/starter.ini
COPY docker/prod/entrypoint.sh /usr/local/bin/starter-entrypoint
COPY docker/prod/prepare-environment.sh /usr/local/bin/starter-prepare-environment
COPY docker/prod/maintenance-entrypoint.sh /usr/local/bin/starter-maintenance
RUN chmod +x /usr/local/bin/starter-entrypoint /usr/local/bin/starter-maintenance
ENTRYPOINT ["starter-entrypoint"]
CMD ["apache2-foreground"]

# Vite resolves Composer module manifests through Artisan, so PHP and vendor are needed.
FROM php-base AS frontend
COPY --from=node-tools /usr/local/bin/node /usr/local/bin/node
COPY --from=node-tools /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf /usr/local/lib/node_modules/corepack/dist/pnpm.js /usr/local/bin/pnpm
ENV VITE_API_BASE_URL=/api/v1
RUN php artisan larastarterkit:frontend --no-interaction && pnpm install --frozen-lockfile && pnpm run build

FROM php-base AS runtime
COPY --from=frontend /var/www/html/public/build public/build

# Dokploy Applications: environment injected at runtime, one process per image.
FROM runtime AS dokploy-web
ENV STARTER_SECRETS_SOURCE=environment \
    APP_ENV=production APP_DEBUG=false LOG_CHANNEL=stderr \
    MCP_HTTP_INTEGRATED_ENABLED=false MCP_HTTP_DEDICATED_ENABLED=false MCP_STDIO_ENABLED=false \
    DB_CONNECTION=mysql QUEUE_CONNECTION=redis CACHE_STORE=redis SESSION_DRIVER=redis \
    SESSION_SECURE_COOKIE=true REDIS_QUEUE_RETRY_AFTER=360
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD ["php", "-r", "exit(@file_get_contents('http://127.0.0.1/up') === false ? 1 : 0);"]

FROM dokploy-web AS dokploy-console
RUN apt-get update && apt-get install -y --no-install-recommends tini \
    && rm -rf /var/lib/apt/lists/*
ENTRYPOINT ["/usr/bin/tini", "-g", "--", "starter-entrypoint"]
USER www-data
STOPSIGNAL SIGTERM

FROM dokploy-console AS dokploy-worker
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD ["php", "artisan", "horizon:status", "--no-interaction"]
CMD ["php", "artisan", "horizon", "--no-interaction"]

FROM dokploy-console AS dokploy-scheduler
HEALTHCHECK NONE
CMD ["php", "artisan", "schedule:work", "--no-interaction"]

FROM dokploy-console AS dokploy-reverb
ENV REVERB_SERVER_HOST=0.0.0.0 REVERB_SERVER_PORT=8080
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["php", "-r", "exit(@fsockopen('127.0.0.1', 8080) === false ? 1 : 0);"]
CMD ["php", "artisan", "reverb:start", "--host=0.0.0.0", "--port=8080", "--no-interaction"]

# Run once with maintenance credentials before deploying the runtime services.
FROM dokploy-web AS dokploy-maintenance
HEALTHCHECK NONE
ENTRYPOINT ["starter-maintenance"]
CMD ["migrate"]

# Static documentation: independent from PHP, SQL and application secrets.
FROM node:24-bookworm-slim AS documentation-build
WORKDIR /docs
# The Docker context excludes Git history; omit Git-derived modification dates.
ENV STARTER_DOCS_LAST_UPDATED=false
RUN corepack enable && corepack prepare pnpm@9.12.2 --activate
COPY packages/documentation/module/package.json packages/documentation/module/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY packages/documentation/module/docs ./docs
RUN pnpm run docs:build

FROM nginx:stable-alpine AS dokploy-documentation
COPY docker/prod/documentation.conf /etc/nginx/conf.d/default.conf
COPY --from=documentation-build /docs/docs/.vitepress/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1

# Dedicated CMS builder. The general Horizon worker does not consume this queue.
FROM dokploy-console AS dokploy-documentation-builder
USER root
COPY --from=frontend /usr/local/bin/node /usr/local/bin/node
COPY --from=frontend /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=frontend /var/www/html/node_modules /var/www/html/node_modules
RUN ln -sf /usr/local/lib/node_modules/corepack/dist/pnpm.js /usr/local/bin/pnpm
ENV DOCUMENTATION_QUEUE_CONNECTION=documentation DOCUMENTATION_PUBLIC_LINK=false
HEALTHCHECK NONE
USER www-data
CMD ["php", "artisan", "queue:work", "documentation", "--queue=documentation", "--timeout=300", "--tries=1", "--no-interaction"]

# Public CMS output; only releases from the shared volume are exposed.
FROM nginx:stable-alpine AS dokploy-documentation-cms
COPY docker/prod/documentation-cms.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1

# Preserve the default image used by the existing local/production Compose files.
FROM runtime AS production
