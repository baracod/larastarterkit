# Copier vers worker.env. Les valeurs partagees doivent correspondre a app.env.
STARTER_SECRETS_SOURCE=environment
APP_NAME="Sneat Starter"
APP_ENV=production
APP_DEBUG=false
APP_KEY=REMPLACER_CLE_LARAVEL_BASE64
APP_URL=https://starter.example.org
LOG_CHANNEL=stderr
MCP_HTTP_INTEGRATED_ENABLED=false
MCP_HTTP_DEDICATED_ENABLED=false
MCP_STDIO_ENABLED=false
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=starter
DB_USERNAME=starter_runtime
DB_PASSWORD=REMPLACER_SECRET_DB
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REMPLACER_SECRET_REDIS
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=starter.example.org
REDIS_QUEUE_RETRY_AFTER=360
MAIL_MAILER=smtp
MAIL_HOST=REMPLACER_HOTE_SMTP
MAIL_PORT=587
MAIL_USERNAME=REMPLACER_UTILISATEUR_SMTP
MAIL_PASSWORD=REMPLACER_SECRET_SMTP
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=notifications@example.org
MAIL_FROM_NAME=STARTER
FILESYSTEM_DISK=local
# R2/S3 : ajouter d'abord le pilote PHP S3 et reconstruire l'image.
