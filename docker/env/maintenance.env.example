# Copier les variables de app.env dans maintenance.env, puis remplacer/ajouter :
# Ce fichier est réservé à la tâche migrate, jamais au web/worker/scheduler.
DB_USERNAME=root
DB_PASSWORD=REMPLACER_SECRET_ROOT_DISTINCT
STARTER_RUNTIME_DB_USERNAME=starter_runtime
STARTER_RUNTIME_DB_PASSWORD=REMPLACER_SECRET_DB_APPLICATIF_20_CARACTERES_MINIMUM
# app.env, worker.env et scheduler.env doivent utiliser ce compte starter_runtime.
