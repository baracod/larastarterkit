BLOCKCHAIN_SERVICE_URL=
BLOCKCHAIN_SERVICE_HOST=
BLOCKCHAIN_SERVICE_PORT=
BLOCKCHAIN_SERVICE_TIMEOUT=

# Réseau local (hardhat standalone node sur port 8545)
# Compte #0 hardhat - clé publiquement connue, NE PAS utiliser en production
TRACKER_NOTARY_RPC_URL=
TRACKER_NOTARY_CONTRACT=
TRACKER_NOTARY_PRIVATE_KEY=

# Polygon Amoy testnet (remplir après déploiement)
