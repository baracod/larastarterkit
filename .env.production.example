# Copy to .env.production. Use: docker compose --env-file .env.production -f docker-compose.prod.yml ...
APP_NAME="Sneat Starter"
APP_DOMAIN=
APP_ENV=production
APP_DEBUG=false
APP_URL=
COMPOSE_PROJECT_NAME=starter-production
DB_DATABASE=starter
DB_USERNAME=starter_runtime
SANCTUM_STATEFUL_DOMAINS=
SESSION_SECURE_COOKIE=true
# polygon/mainnet for production; Sepolia for explicitly authorized preproduction.
# Hardhat is reserved for development.
# Paste the HTTPS RPC endpoint from your Infura project for the network above.
# Hardhat runs only in docker-compose.local.yml.
# Configure a working production mail transport.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=STARTER
