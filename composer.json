{
  "name": "baracod/larastarterkit-development",
  "type": "project",
  "description": "Development and reference application for Baracod Larastarterkit",
  "keywords": [
    "laravel",
    "framework"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "baracod/larastarterkit-core": "1.0.0-rc.1",
    "baracod/larastarterkit-documentation": "1.0.0-rc.1",
    "laravel/tinker": "^2.9"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "larastan/larastan": "^3.6",
    "laravel/boost": "^2.10",
    "laravel/pint": "^1.13",
    "laravel/sail": "^1.26",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.0",
    "phpunit/phpunit": "^11.0.1",
    "baracod/larastarterkit-generator": "1.0.0-rc.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Modules\\": "Modules/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi",
      "@php artisan larastarterkit:frontend --no-interaction"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi --no-interaction"
    ]
  },
  "extra": {},
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true,
      "wikimedia/composer-merge-plugin": true
    },
    "platform": {
      "php": "8.4.0"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "path",
      "url": "packages/*",
      "options": {
        "symlink": true,
        "versions": {
          "baracod/larastarterkit-core": "1.0.0-rc.1",
          "baracod/larastarterkit-documentation": "1.0.0-rc.1",
          "baracod/larastarterkit-generator": "1.0.0-rc.1"
        }
      }
    }
  ]
}
