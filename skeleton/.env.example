APP_NAME="Baracod Larastarterkit"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
# VITE_API_BASE_URL=
# VITE_DEV_SERVER_URL=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# APP_MAINTENANCE_DRIVER=

# PHP_CLI_SERVER_WORKERS=

# BCRYPT_ROUNDS=

LOG_CHANNEL=stack
LOG_STACK=single
# LOG_DEPRECATIONS_CHANNEL=
# LOG_LEVEL=

DB_CONNECTION=sqlite
# DB_HOST=
# DB_PORT=
# DB_DATABASE=
# DB_ROOT_PASSWORD=
# DB_USERNAME=
# DB_PASSWORD=
# DB_TIMEZONE=

SESSION_DRIVER=database
# SESSION_LIFETIME=
# SESSION_ENCRYPT=
# SESSION_PATH=
# SESSION_DOMAIN=

BROADCAST_CONNECTION=null
# FILESYSTEM_DISK=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# MEMCACHED_HOST=

# REDIS_CLIENT=
# REDIS_HOST=
# REDIS_PASSWORD=
# REDIS_PORT=

MAIL_MAILER=log
# MAIL_SCHEME=
# MAIL_HOST=
# MAIL_PORT=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"
# Frontend URL for CORS configuration
# FRONTEND_URL=

# Sanctum Token Expiration (in minutes) - 1440 = 24 hours
# SANCTUM_EXPIRATION=
# Extra first-party hosts (host:port) allowed to log in with the session cookie, e.g. a separate SPA domain.
# SANCTUM_STATEFUL_DOMAINS=

# Log auth days retention
# LOG_AUTH_DAYS=

# Throttle Rate Limiting (requests/minute or requests/period)
# Adjust for your needs - higher in dev, lower in production
# THROTTLE_LOGIN=
# THROTTLE_PASSWORD_RESET=

# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Facultatif : assistance IA du générateur
# DEEPSEEK_API_KEY=
# GENERATOR_AI_PROVIDER=
# GENERATOR_AI_MODEL=
GENERATOR_AI_ENABLED=false
GENERATOR_AI_TRANSLATIONS=true
