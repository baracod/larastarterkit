{
  "name": "baracod/larastarterkit",
  "type": "project",
  "description": "Modular Laravel starter with independently updatable Baracod packages",
  "keywords": [
    "laravel",
    "framework"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "baracod/larastarterkit-core": "^1.0@RC",
    "laravel/tinker": "^2.9"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "larastan/larastan": "^3.6",
    "laravel/boost": "^2.10",
    "laravel/pint": "^1.13",
    "laravel/sail": "^1.26",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.0",
    "phpunit/phpunit": "^11.0.1",
    "baracod/larastarterkit-generator": "^1.0@RC"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Modules\\": "Modules/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi",
      "@php artisan larastarterkit:frontend --no-interaction"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi --no-interaction",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php -r \"echo PHP_EOL.'Next steps:'.PHP_EOL.'  1. Configure .env (APP_URL, database)'.PHP_EOL.'  2. php artisan migrate --no-interaction'.PHP_EOL.'  3. php artisan larastarterkit:install --no-interaction'.PHP_EOL.'  4. php artisan auth:super-admin:create'.PHP_EOL.'  5. pnpm install && pnpm run build'.PHP_EOL;\""
    ]
  },
  "extra": {},
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true,
      "wikimedia/composer-merge-plugin": true
    },
    "platform": {
      "php": "8.4.0"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
