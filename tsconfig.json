{
  "extends": "ts-node/node16/tsconfig.json",
  "ts-node": {
    // Tell ts-node CLI to install the --loader automatically
    "esm": true,
  },
  "compilerOptions": {
    "baseUrl": ".",
    "target": "esnext",
    "useDefineForClassFields": true,
    "module": "esnext",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "strict": true,
    "jsx": "preserve",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": [
        "./resources/ts/*"
      ],
      "@themeConfig": [
        "./themeConfig.ts"
      ],
      "@layouts/*": [
        "./resources/ts/@layouts/*"
      ],
      "@layouts": [
        "./resources/ts/@layouts"
      ],
      "@core/*": [
        "./resources/ts/@core/*"
      ],
      "@core": [
        "./resources/ts/@core"
      ],
      "@images/*": [
        "./resources/images/*"
      ],
      "@styles/*": [
        "./resources/styles/*"
      ],
      "@validators": [
        "./resources/ts/@core/utils/validators"
      ],
      "@api-utils/*": [
        "./resources/ts/plugins/fake-api/utils/*"
      ],
      "@core-scss/*": [
        "resources/styles/@core/*"
      ],
      "@modules/*": [
        "./Modules/*/resources/ts/"
      ],
      "@module-type": [
        "Modules/*/resources/ts/types/"
      ],
      "@module-components": [
        "Modules/*/resources/ts/components/"
      ],
      "@module-api": [
        "Modules/*/resources/ts/apis/"
      ],
      "@documentation/*": ["Modules/Documentation/resources/ts/*"],
      "@auth/*": [
        "Modules/Auth/resources/ts/*"
      ],
      "@admin/*": [
        "Modules/Admin/resources/ts/*"
      ],
    },
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "scripthost"
    ],
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "unplugin-vue-router/client",
      "vite-plugin-vue-layouts/client"
    ]
  },
  "include": [
    "./typed-router.d.ts",
    "./vite.config.*",
    "./env.d.ts",
    "./shims.d.ts",
    "./auto-imports.d.ts",
    "./components.d.ts",
    "./resources/ts/**/*",
    "./resources/ts/**/*.vue",
    "./themeConfig.ts",
    "./Modules/*/resources/ts/**/*",
    "./Modules/*/resources/ts/**/*.vue",
    "./Modules/Blog/resources/ts/**/*",
  ],
  "exclude": [
    "./dist",
    "./node_modules",
    "./Modules/Auth/resources/ts/stores/user.ts",
    "./Modules/Auth/resources/ts/pages/users/read copy.vue",
    "./resources/ts/components/UserProfile copy.vue"
  ],
}
