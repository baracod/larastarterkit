<script setup lang="ts">
import { {{ modelName }}API } from '../../api/{{ modelName }}'
import type { I{{ modelName }} } from '../../types/entities'
import {{ moduleName }}{{ modelName }}AddOrEdit from '../../components/{{ moduleName }}{{ modelName }}AddOrEdit.vue'

definePage({
  meta: {
    action: 'browse',
    subject: '{{ permissionsSubject }}',
  },
})

const { confirmDialog } = useConfirm()
const { {{ i18nImports }} } = useI18n({ useScope: 'global' })
const { tHeaderCols } = useTranslater()
const { notify } = useNotify()

const entity = '{{ entityKey }}'
const items = ref<I{{ modelName }}[]>([])
const loading = ref(true)
const editDialog = ref(false)
const selectedItem = ref<I{{ modelName }} | null>(null)
const selectedIds = ref<number[]>([])
const readOnly = ref(false)
const searchKey = ref('')

const headers = tHeaderCols({
  entity,
  module: '{{ moduleName }}',
  headers: [
    {{ headers }}
    { title: 'actions', key: 'actions', sortable: false, translate: false, align: 'end' },
  ],
})

{{ dateHelper }}
async function getData() {
  loading.value = true
  try {
    items.value = await {{ modelName }}API.getAll()
  }
  catch {
    notify({ type: 'error', message: t('message.notification.error') })
  }
  finally {
    loading.value = false
  }
}

onMounted(getData)

function openCreateDialog() {
  selectedItem.value = null
  readOnly.value = false
  editDialog.value = true
}

function openEditDialog(item: I{{ modelName }}) {
  selectedItem.value = item
  readOnly.value = false
  editDialog.value = true
}

function openDetailDialog(item: I{{ modelName }}) {
  selectedItem.value = item
  readOnly.value = true
  editDialog.value = true
}

async function deleteItem(id: number) {
  if (!await confirmDialog())
    return
  loading.value = true
  try {
    await {{ modelName }}API.delete(id)
    await getData()
  }
  finally {
    loading.value = false
  }
}

async function deleteSelected() {
  if (!selectedIds.value.length || !await confirmDialog())
    return
  loading.value = true
  try {
    await {{ modelName }}API.deleteMultiple(selectedIds.value)
    selectedIds.value = []
    await getData()
  }
  finally {
    loading.value = false
  }
}

async function refreshList() {
  editDialog.value = false
  await getData()
}
</script>

<template>
  <VCard>
    <VCardTitle class="d-flex flex-wrap justify-space-between align-center gap-3">
      <h2>{{ t(`{{ moduleName }}.${entity}.titlePlural`) }}</h2>
      <div class="flex-grow-1">
        <CoreTextField
          v-model="searchKey"
          :placeholder="t('action.search')"
          class="mx-auto pa-0"
          append-inner-icon="bx-search"
          clearable
        />
      </div>
      <div class="action">
        <VBtn
          class="ms-1"
          color="secondary"
          :title="t('action.refresh')"
          icon="bx-refresh"
          @click="refreshList"
        />
        <VBtn
          v-if="$can('add', '{{ permissionsSubject }}')"
          class="ms-1"
          color="success"
          :title="t('action.add')"
          icon="bx-plus"
          @click="openCreateDialog"
        />
        <VBtn
          v-if="selectedIds.length && $can('delete', '{{ permissionsSubject }}')"
          class="ms-1"
          color="error"
          :title="t('action.delete')"
          icon="bx-trash"
          @click="deleteSelected"
        />
      </div>
    </VCardTitle>
    <VCardText>
      <VDataTable
        v-model="selectedIds"
        :show-select="$can('delete', '{{ permissionsSubject }}')"
        item-value="id"
        :loading="loading"
        :headers="headers"
        :items="items"
        :search="searchKey"
      >
        {{ customDisplayColumn }}

        <template #item.actions="{ item }">
          <div class="d-flex flex-nowrap align-center justify-end px-1">
            <VBtn
              color="info"
              variant="text"
              icon="bx-show-alt"
              density="compact"
              :title="t('action.details')"
              @click="openDetailDialog(item)"
            />
            <VBtn
              v-if="$can('edit', '{{ permissionsSubject }}')"
              variant="text"
              icon="bx-edit-alt"
              density="compact"
              :title="t('action.edit')"
              @click="openEditDialog(item)"
            />
            <VBtn
              v-if="$can('delete', '{{ permissionsSubject }}')"
              color="error"
              variant="text"
              icon="bx-trash-alt"
              density="compact"
              :title="t('action.delete')"
              @click="deleteItem(item.id!)"
            />
          </div>
        </template>
      </VDataTable>
    </VCardText>
  </VCard>

  <{{ moduleName }}{{ modelName }}AddOrEdit
    v-model="editDialog"
    :view-only="readOnly"
    :item="selectedItem ?? undefined"
    @saved="refreshList"
  />
</template>
